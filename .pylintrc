# This Pylint rcfile contains a configuration to uphold the style
# described in the Google Python style guide for the public Vanir project.
# Enforces common checks and disables noisy checks for C++ extensions.

[MASTER]
# Files or directories to be skipped.
ignore=third_party,testdata

# Use multiple processes to speed up Pylint.
jobs=4

# Do not allow loading arbitrary C extensions unless safe.
unsafe-load-any-extension=no

[MESSAGES CONTROL]
# Disable specific messages.
disable=
    # Crucial for hybrid Python/C++ projects without pre-built extensions in CI:
    import-error,
    no-name-in-module,
    no-member,
    c-extension-no-member,

    # Google-internal gpylint custom checks might leave pragmas that standard pylint doesn't know:
    bad-option-value,

    # Design complexity checks (noisy, subjective):
    too-many-arguments,
    too-many-locals,
    too-many-branches,
    too-many-statements,
    too-many-instance-attributes,
    too-many-public-methods,
    too-many-return-statements,
    too-many-nested-blocks,
    too-few-public-methods,
    too-many-ancestors,

    # Duplicate code (noisy in tests/mock setups):
    duplicate-code,

    # Formatting and other stylistic warnings that formatters (yapf/black) handle better:
    bad-continuation,
    bad-whitespace,

    # Other common relaxations:
    fixme,              # Allow TODOs
    locally-disabled,   # Allow local disabling in code comments
    suppressed-message, # Hide suppression confirmations
    useless-suppression

[FORMAT]
# Enforce Google internal/OSS standard 2-space indentation
indent-string='  '

# Enforce Google Style max line length
max-line-length=80

[REPORTS]
# Run in quiet mode (only print messages, no full reports/scores)
reports=no
score=no
